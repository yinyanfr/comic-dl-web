# Copy to .env; protect with chmod 600. Compose reads this file for substitution.
# No release image is assumed to exist yet. For a local build:
# docker build -t comic-dl-web:local .
IMAGE=comic-dl-web:local
LOCAL_UID=1000
LOCAL_GID=1000
DATA_DIRECTORY=/absolute/path/to/comic-dl-web/data
DOWNLOAD_DIRECTORY=/absolute/path/to/comics
BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
# Replace with a strong random password before starting.
COMIC_DL_WEB_ADMIN_PASSWORD=
COMIC_DL_WEB_ENABLE_EXTENSION_MANAGEMENT=0
COMIC_DL_WEB_WATCH_INTERVAL=3600
# Extra application variables must also be added to compose.yaml environment,
# or to a Compose override. Merely adding them here does not pass them through.
