{
  "name": "comic-dl-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node server.ts --dev",
    "build": "react-router build",
    "start": "node server.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,tsx,jsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{css,json,md,yaml,yml}": "prettier --write"
  },
  "overrides": {
    "cheerio": {
      "encoding-sniffer": "1.0.2"
    }
  },
  "dependencies": {
    "@comic-dl/copymanga": "^0.3.0",
    "@comic-dl/dm5": "^0.2.1",
    "@comic-dl/kavita": "^0.3.0",
    "@comic-dl/komga": "^0.3.0",
    "@comic-dl/zerobyw": "^0.3.1",
    "@mantine/core": "^9.8.2",
    "@mantine/hooks": "^9.8.2",
    "@react-router/express": "^7.18.7",
    "@react-router/node": "^7.18.7",
    "comic-dl": "^4.0.0",
    "express": "^4.22.3",
    "isbot": "^5.2.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.65.1",
    "@react-router/dev": "^7.18.7",
    "@types/express": "^4.17.25",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@zip.js/zip.js": "^2.25.0",
    "comic-dl-v3": "npm:comic-dl@3.2.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.8",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "better-sqlite3@13.2.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
